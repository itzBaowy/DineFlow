{
  "name": "@dineflow/api",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist/src",
    "dist/prisma",
    "prisma"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "predev": "pnpm build",
    "dev": "concurrently -k \"tsc -p tsconfig.json --watch\" \"node --watch --watch-preserve-output dist/src/main.js\"",
    "start": "node dist/src/main.js",
    "lint": "eslint src test prisma prisma.config.ts",
    "platform:bootstrap": "pnpm build && node dist/prisma/platform-admin.js",
    "platform:mfa-recovery": "pnpm build && node dist/prisma/platform-mfa-recovery.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test dist/test/unit.test.js",
    "test:integration": "pnpm build && node dist/test/prepare-db.js && node --test --test-concurrency=1 dist/test/auth.integration.test.js dist/test/setup.integration.test.js dist/test/ordering.integration.test.js dist/test/operations.integration.test.js dist/test/realtime.integration.test.js dist/test/billing.integration.test.js dist/test/admin.integration.test.js dist/test/saas.integration.test.js dist/test/tenancy.integration.test.js dist/test/security.integration.test.js dist/test/deployment.integration.test.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "pnpm build && node dist/prisma/seed.js",
    "db:validate": "prisma validate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1147.0",
    "@dineflow/shared": "workspace:*",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/platform-socket.io": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/websockets": "12.1.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.0.0",
    "helmet": "^8.0.0",
    "nodemailer": "10.0.16",
    "pg": "^8.0.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "sharp": "0.35.5",
    "socket.io": "4.8.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.0",
    "@types/express": "^5.0.0",
    "@types/multer": "2.3.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.0.0",
    "@types/qrcode": "1.5.6",
    "concurrently": "^9.0.0",
    "jsqr": "1.4.0",
    "prisma": "7.10.0",
    "socket.io-client": "4.8.4"
  }
}
