{
  "name": "@dineflow/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "predev": "pnpm build",
    "dev": "concurrently -k \"tsc -p tsconfig.json --watch\" \"node --watch --watch-preserve-output dist/src/main.js\"",
    "start": "node dist/src/main.js",
    "lint": "eslint src test prisma/seed.ts prisma.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test dist/test/unit.test.js",
    "test:integration": "pnpm build && node dist/test/prepare-db.js && node --test dist/test/auth.integration.test.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "pnpm build && node dist/prisma/seed.js",
    "db:validate": "prisma validate"
  },
  "dependencies": {
    "@dineflow/shared": "workspace:*",
    "@nestjs/common": "12.1.2", "@nestjs/core": "12.1.2", "@nestjs/platform-express": "12.1.2",
    "@nestjs/jwt": "12.0.2", "@nestjs/swagger": "12.0.2", "@nestjs/throttler": "6.7.1",
    "@prisma/client": "7.10.0", "@prisma/adapter-pg": "7.10.0", "pg": "^8.0.0",
    "cookie-parser": "^1.4.7", "dotenv": "^17.0.0", "helmet": "^8.0.0",
    "reflect-metadata": "^0.2.2", "rxjs": "^7.8.0", "zod": "4.6.5"
  },
  "devDependencies": { "prisma": "7.10.0", "concurrently": "^9.0.0", "@types/express": "^5.0.0", "@types/cookie-parser": "^1.4.0", "@types/pg": "^8.0.0" }
}
