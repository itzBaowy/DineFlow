# Run pnpm setup:env to generate local credentials. Never use these markers.
NODE_ENV=development
API_PORT=4000
APP_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://localhost:4000
POSTGRES_USER=dineflow
POSTGRES_PASSWORD=GENERATE_LOCALLY
POSTGRES_DB=dineflow
POSTGRES_PORT=5432
DATABASE_URL=postgresql://dineflow:GENERATE_LOCALLY@localhost:5432/dineflow?schema=public
JWT_ACCESS_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
GUEST_TOKEN_TTL_SECONDS=14400
COOKIE_SECURE=false
REDIS_PORT=6379
REDIS_PASSWORD=GENERATE_LOCALLY
REDIS_URL=redis://:GENERATE_LOCALLY@localhost:6379
MINIO_ROOT_USER=dineflow-local
MINIO_ROOT_PASSWORD=GENERATE_LOCALLY
S3_ENDPOINT=http://localhost:9000
# API container uses Compose DNS; host integration tests keep S3_ENDPOINT above.
DOCKER_S3_ENDPOINT=http://minio:9000
S3_BUCKET=dineflow-menu
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=dineflow-local
S3_SECRET_ACCESS_KEY=GENERATE_LOCALLY
S3_AUTO_CREATE_BUCKET=true
# Local-only demo users. Seed aborts if this is missing or weak.
SEED_DEMO_PASSWORD=GENERATE_LOCALLY
