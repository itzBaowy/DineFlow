# Run pnpm setup:env to generate local credentials. Never use these markers.
NODE_ENV=development
API_PORT=4000
APP_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://localhost:4000
POSTGRES_USER=dineflow
POSTGRES_PASSWORD=GENERATE_LOCALLY
POSTGRES_DB=dineflow
POSTGRES_PORT=5432
DATABASE_URL=postgresql://dineflow:GENERATE_LOCALLY@localhost:5432/dineflow?schema=public
JWT_ACCESS_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES
ACCOUNT_SECURITY_KEY=GENERATE_32_RANDOM_BYTES_HEX
# Local SMTP uses Mailpit. Production requires authenticated SMTP and a real sender.
SMTP_HOST=localhost
DOCKER_SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
EMAIL_FROM=no-reply@dineflow.local
EMAIL_PROVIDER=smtp
# Production: EMAIL_PROVIDER=resend + RESEND_API_KEY + verified EMAIL_FROM.
# RESEND_API_KEY=
# SMTP_USER=
# SMTP_PASSWORD=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
GUEST_TOKEN_TTL_SECONDS=14400
COOKIE_SECURE=false
REDIS_PORT=6379
REDIS_PASSWORD=GENERATE_LOCALLY
REDIS_URL=redis://:GENERATE_LOCALLY@localhost:6379
MINIO_ROOT_USER=dineflow-local
MINIO_ROOT_PASSWORD=GENERATE_LOCALLY
S3_ENDPOINT=http://localhost:9000
# API container uses Compose DNS; host integration tests keep S3_ENDPOINT above.
DOCKER_S3_ENDPOINT=http://minio:9000
S3_BUCKET=dineflow-menu
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=dineflow-local
S3_SECRET_ACCESS_KEY=GENERATE_LOCALLY
S3_AUTO_CREATE_BUCKET=true
# Local-only demo users. Seed aborts if this is missing or weak.
SEED_DEMO_PASSWORD=GENERATE_LOCALLY
# Separate platform admin, created only by pnpm platform:bootstrap (never signup).
PLATFORM_ADMIN_EMAIL=admin@dineflow.local
PLATFORM_ADMIN_NAME=DineFlow Platform Admin
PLATFORM_ADMIN_PASSWORD=GENERATE_LOCALLY
